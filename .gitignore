# ===========================================================================
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/App.framework
ios/Flutter/ephemeral/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*
**/Flutter/App.framework/
**/Flutter/ephemeral/
**/*.mode1v3
**/*.mode2v3
**/*.perspectivev3
**/*.pbxuser
**/xcuserdata/
**/DerivedData/
Podfile.lock
macos/Flutter/ephemeral/
macos/Pods/

# ===========================================================================
# 7. Web and the proxy
# ===========================================================================
# `web/` itself is committed — it holds index.html, the manifest and the
# icons that install_icons.bat writes. Only generated output is ignored.
node_modules/
proxy/node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

