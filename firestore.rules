rules_version = '2';

// ---------------------------------------------------------------------------
// IBTIDAA TECH SDG APP - Firestore security rules
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Three things in this file matter more than the rest:
//
//   1. /_secrets/{doc} denies ALL client access. AI provider keys written
//      there can only be read by the Render proxy, which uses the Admin SDK
//      and bypasses rules because it runs on a server you control.
//
//   2. ROOT_OWNER is the recovery account, matched by email. It keeps working
//      even if the users collection is wiped, and cannot be demoted from
//      inside the app. Changing it means editing this file and redeploying.
//
//   3. Rules are OR'd, not overridden. A broad `match` does not get narrowed
//      by a more specific one - if either grants access, access is granted.
//      That is why the wildcard content rule below explicitly excludes
//      'reports'. Without that exclusion, abuse reports would be world
//      readable despite the specific rule above denying it.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity ----------
    function signedIn() {
      return request.auth != null;
    }

    // request.auth.token.email is absent for anonymous sign-in, so it is
    // checked before any method is called on it.
    function myEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    // Permanent master admin. Must match AdminConfig.rootOwnerEmail in
    // lib/core/admin/admin_config.dart.
    function isRootOwner() {
      return myEmail() == 'free.timesenjoy@gmail.com';
    }

    function adminConfig() {
      return get(/databases/$(database)/documents/config/admin).data;
    }

    // The transferable owner, stored in /config/admin. Guarded with exists()
    // so the rules work before that document has ever been written.
    function isActiveOwner() {
      return myEmail() != ''
        && exists(/databases/$(database)/documents/config/admin)
        && adminConfig().ownerEmail is string
        && myEmail() == adminConfig().ownerEmail.lower();
    }

    function isOwner() {
      return isRootOwner() || isActiveOwner();
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isOwner() || (hasUserDoc() && myUser().role == 'super_admin');
    }

    function isAdmin() {
      return isSuperAdmin() || (hasUserDoc() && myUser().role == 'admin');
    }

    // Can this person edit a particular goal's content?
    function canEditGoal(goal) {
      return isSuperAdmin()
        || (hasUserDoc()
            && myUser().role == 'admin'
            && myUser().sdgAccess is list
            && goal in myUser().sdgAccess);
    }

    // ---------- owner record ----------
    // Any signed-in user may read it, because the app needs to know who the
    // owner is to decide what to show. Only the current owner may change it,
    // which is what makes transfer possible without opening a hole.
    match /config/admin {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // ---------- SECRETS: nothing client-side, ever ----------
    // Not even for the owner at runtime - an admin account can be phished,
    // and this is the one thing that must survive that. To seed keys, open
    // `write` briefly and close it again; see the README.
    match /_secrets/{doc} {
      allow read: if false;
      allow write: if false;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isSuperAdmin();
      allow create: if signedIn() && request.auth.uid == uid;

      // A user may edit their own profile but NOT their own permissions.
      // Without this, anyone could make themselves an admin.
      allow update: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['role', 'sdgAccess']);

      // Super admins grant and revoke access - except on the recovery
      // account, which nobody can alter from inside the app.
      allow update: if isSuperAdmin()
        && !(resource.data.email is string
             && resource.data.email.lower() == 'free.timesenjoy@gmail.com');

      allow delete: if false;
    }

    // ---------- AI provider status (NO keys here) ----------
    match /aiProviders/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ---------- notifications ----------
    match /notifications/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- device tokens for push ----------
    match /deviceTokens/{token} {
      allow read: if false;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // ---------- SDG 5 abuse reports ----------
    // Write-only from the client. Nobody using the app can read reports
    // back - not their own, not anyone else's. If they were readable by
    // their author, anyone holding an unlocked phone could read them.
    // Admins read them in the Firebase console, or server-side.
    match /sdg/5/reports/{reportId} {
      allow read: if false;
      allow create: if
        request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.mode in ['anonymous', 'withContact']
        // An anonymous report must carry nothing identifying. Enforced here
        // rather than trusted from the client.
        && (request.resource.data.mode != 'anonymous'
            || (!('uid' in request.resource.data)
                && !('contact' in request.resource.data)));
      allow update, delete: if false;
    }

    // ---------- SDG content and admin corrections ----------
    // Public read, because these overrides are merged over the bundled data
    // so a corrected government link reaches every device.
    //
    // 'reports' is excluded explicitly. Rules are OR'd, so without this the
    // wildcard would grant the public read that the rule above denies.
    match /sdg/{goal} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /{collection}/{docId} {
        allow read: if collection != 'reports';
        allow write: if collection != 'reports' && canEditGoal(int(goal));
      }
    }

    // ---------- user-generated submissions ----------
    match /submissions/{goal}/items/{itemId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
